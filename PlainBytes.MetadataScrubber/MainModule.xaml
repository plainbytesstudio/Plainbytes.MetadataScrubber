<UserControl
    x:Class="PlainBytes.MetadataScrubber.MainModule"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:res="clr-namespace:PlainBytes.MetadataScrubber.Resources"
    d:DesignHeight="560"
    d:DesignWidth="800"
    FontFamily="{DynamicResource PB.Fonts.Main}"
    Foreground="{DynamicResource PB.Brushes.TextPrimary}"
    Focusable="False"
    FocusVisualStyle="{x:Null}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style
            x:Key="ClearFileListButtonStyle"
            BasedOn="{StaticResource {x:Type ui:Button}}"
            TargetType="ui:Button">
            <Setter Property="Appearance" Value="Transparent" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#0F172A" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FileListMetaTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="FileListStatusTextStyle" TargetType="TextBlock" BasedOn="{StaticResource FileListMetaTextStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFailed}" Value="True">
                    <Setter Property="Foreground" Value="#9F1239" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FileListRowStyle" TargetType="Border">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#EEF2F7" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="ClipToBounds" Value="True" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F5F9" />
                    <Setter Property="BorderBrush" Value="#E2E8F0" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style
            x:Key="FileRowActionButtonStyle"
            BasedOn="{StaticResource {x:Type ui:Button}}"
            TargetType="ui:Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Appearance" Value="Transparent" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F5F9" />
                    <Setter Property="Foreground" Value="#334155" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MetaGroupTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="MetaFieldNameStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,0,20,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="MetaFieldValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <DataTemplate x:Key="MetaFieldTemplate">
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="128" SharedSizeGroup="MetaFieldLabel" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Style="{StaticResource MetaFieldNameStyle}"
                    Text="{Binding Name}" />
                <TextBlock
                    Grid.Column="1"
                    Style="{StaticResource MetaFieldValueStyle}"
                    Text="{Binding Value}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="MetaGroupTemplate">
            <StackPanel Margin="0,0,0,16">
                <TextBlock Style="{StaticResource MetaGroupTitleStyle}" Text="{Binding Title}" />
                <ItemsControl
                    ItemTemplate="{StaticResource MetaFieldTemplate}"
                    ItemsSource="{Binding Fields}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="FileListItemTemplate">
            <Border Style="{StaticResource FileListRowStyle}" Tag="FileRow">
                <StackPanel>
                    <!-- 主行 -->
                    <Grid
                        Height="76"
                        Margin="16,0"
                        Cursor="Hand"
                        Background="Transparent"
                        MouseLeftButtonUp="FileRow_MouseLeftButtonUp">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="52*" />
                            <ColumnDefinition Width="15*" />
                            <ColumnDefinition Width="12*" />
                            <ColumnDefinition Width="13*" />
                            <ColumnDefinition Width="8*" />
                        </Grid.ColumnDefinitions>

                        <Grid
                            Grid.Column="0"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Image
                                Grid.Column="0"
                                Width="40"
                                Height="40"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                RenderOptions.BitmapScalingMode="HighQuality"
                                Source="{Binding IconPath}" />
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center">
                                <TextBlock
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Foreground="#0F172A"
                                    Text="{Binding FileName}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                                <TextBlock
                                    Margin="0,3,0,0"
                                    FontSize="12"
                                    FontWeight="Normal"
                                    Foreground="#94A3B8"
                                    Text="{Binding FilePath}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                            </StackPanel>
                        </Grid>

                        <TextBlock
                            Grid.Column="1"
                            Style="{StaticResource FileListMetaTextStyle}"
                            Text="{Binding TypeLabel}" />
                        <TextBlock
                            Grid.Column="2"
                            Style="{StaticResource FileListMetaTextStyle}"
                            Text="{Binding SizeLabel}" />
                        <TextBlock
                            Grid.Column="3"
                            Style="{StaticResource FileListStatusTextStyle}"
                            Text="{Binding Status}" />

                        <StackPanel
                            Grid.Column="4"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                            <ui:Button
                                Style="{StaticResource FileRowActionButtonStyle}"
                                Click="FileRowExpand_Click">
                                <ui:SymbolIcon FontSize="16">
                                    <ui:SymbolIcon.Style>
                                        <Style TargetType="ui:SymbolIcon">
                                            <Setter Property="Symbol" Value="ChevronDown24" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                    <Setter Property="Symbol" Value="ChevronUp24" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:SymbolIcon.Style>
                                </ui:SymbolIcon>
                            </ui:Button>
                            <ui:Button
                                Style="{StaticResource FileRowActionButtonStyle}"
                                Icon="{ui:SymbolIcon Symbol=Dismiss24, FontSize=16}"
                                Click="FileRowRemove_Click" />
                        </StackPanel>
                    </Grid>

                    <!-- 展开区：色块分区，无顶部分割线 -->
                    <Border
                        x:Name="ExpandPanel"
                        Tag="ExpandPanel"
                        Background="#F8FAFC"
                        BorderThickness="0"
                        Padding="72,22,72,22"
                        SnapsToDevicePixels="True">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Setter Property="Opacity" Value="0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation
                                                        Storyboard.TargetProperty="Opacity"
                                                        From="0"
                                                        To="1"
                                                        Duration="0:0:0.18" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <Grid>
                            <!-- 有元数据 -->
                            <ItemsControl
                                Grid.IsSharedSizeScope="True"
                                ItemTemplate="{StaticResource MetaGroupTemplate}"
                                ItemsSource="{Binding Groups}">
                                <ItemsControl.Style>
                                    <Style TargetType="ItemsControl">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasMetadata}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.Style>
                            </ItemsControl>

                            <!-- 无元数据 -->
                            <Border
                                Padding="14,12"
                                HorizontalAlignment="Left"
                                Background="#F0FDF4"
                                CornerRadius="8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasMetadata}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Foreground="#166534"
                                        Text="✓" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Foreground="#166534"
                                        Text="{x:Static res:Strings.Home_NoMetadata}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid UseLayoutRounding="True" SnapsToDevicePixels="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="0" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 页面标题 -->
        <StackPanel
            Grid.Row="0"
            Margin="0,0,0,28"
            HorizontalAlignment="Stretch"
            Orientation="Horizontal">
            <Image
                Width="40"
                Height="40"
                Margin="0,0,16,0"
                VerticalAlignment="Center"
                RenderOptions.BitmapScalingMode="HighQuality"
                SnapsToDevicePixels="True"
                Source="pack://application:,,,/PlainBytes.MetadataScrubber;component/Assets/Images/broom.png" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock
                    FontSize="30"
                    FontWeight="SemiBold"
                    LineHeight="40"
                    LineStackingStrategy="BlockLineHeight"
                    Foreground="#0F172A"
                    Text="{x:Static res:Strings.Home_Title}" />
                <TextBlock
                    Margin="0,6,0,0"
                    FontSize="15"
                    FontWeight="Normal"
                    LineHeight="24"
                    LineStackingStrategy="BlockLineHeight"
                    Foreground="{DynamicResource PB.Brushes.TextSecondary}"
                    Text="{x:Static res:Strings.Home_Subtitle}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>

        <!-- 中部：空态拖放区占剩余空间（最大 430）；有文件时拖放区紧凑 + 列表占剩余 -->
        <Grid
            Grid.Row="1"
            MinHeight="0">
            <Grid.RowDefinitions>
                <RowDefinition
                    x:Name="DropZoneRow"
                    Height="*"
                    MaxHeight="430"
                    MinHeight="0" />
                <RowDefinition
                    x:Name="FileListRow"
                    Height="0"
                    MinHeight="0" />
            </Grid.RowDefinitions>

            <!-- 拖放区：空态随行高伸缩，MaxHeight 430；有文件时由代码设为 130 -->
            <Border
                x:Name="DropZone"
                Grid.Row="0"
                Margin="0"
                Padding="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                MaxHeight="430"
                AllowDrop="True"
                Background="#FAFCFF"
                BorderThickness="0"
                CornerRadius="14"
                DragEnter="DropZone_DragEnter"
                DragLeave="DropZone_DragLeave"
                DragOver="DropZone_DragOver"
                Drop="DropZone_Drop"
                SnapsToDevicePixels="True"
                UseLayoutRounding="True">
                <Grid Margin="0">
                    <Rectangle
                        RadiusX="14"
                        RadiusY="14"
                        Stroke="#60A5FA"
                        StrokeDashArray="4 3"
                        StrokeThickness="1"
                        StrokeLineJoin="Round"
                        SnapsToDevicePixels="True"
                        IsHitTestVisible="False" />
                    <StackPanel
                        x:Name="DropZoneContentPanel"
                        Margin="32,10"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="420">
                        <ui:SymbolIcon
                            x:Name="DropZoneIcon"
                            HorizontalAlignment="Center"
                            FontSize="48"
                            Foreground="{DynamicResource PB.Brushes.Primary}"
                            Symbol="FolderOpen24" />

                        <TextBlock
                            x:Name="DropZoneTitle"
                            Margin="0,20,0,0"
                            HorizontalAlignment="Center"
                            FontSize="22"
                            FontWeight="SemiBold"
                            Foreground="#0F172A"
                            Text="{x:Static res:Strings.Home_DropTitle}"
                            TextAlignment="Center" />

                        <TextBlock
                            x:Name="DropZoneSubtitle"
                            Margin="0,6,0,0"
                            HorizontalAlignment="Center"
                            FontSize="14"
                            FontWeight="Normal"
                            Foreground="#64748B"
                            Text="{x:Static res:Strings.Home_DropSubtitle}"
                            TextAlignment="Center" />

                        <ui:Button
                            MinWidth="140"
                            Height="46"
                            Margin="0,18,0,0"
                            Padding="20,0"
                            HorizontalAlignment="Center"
                            Appearance="Primary"
                            Background="#2563EB"
                            BorderBrush="#2563EB"
                            BorderThickness="0"
                            CornerRadius="8"
                            FontSize="16"
                            Foreground="White"
                            Content="{x:Static res:Strings.Home_SelectFiles}"
                            Click="SelectFilesButton_Click">
                            <ui:Button.Icon>
                                <ui:ImageIcon
                                    Width="25"
                                    Height="25"
                                    Source="pack://application:,,,/PlainBytes.MetadataScrubber;component/Assets/Images/folder.png" />
                            </ui:Button.Icon>
                        </ui:Button>

                        <TextBlock
                            x:Name="DropZoneFormatHint"
                            Margin="0,18,0,0"
                            HorizontalAlignment="Center"
                            FontSize="12"
                            FontWeight="Normal"
                            Foreground="#94A3B8"
                            Text="{x:Static res:Strings.Home_FormatHint}"
                            TextAlignment="Center"
                            TextWrapping="NoWrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 文件列表：浅底分区壳 + 抬头色块；仅文件行区域滚动 -->
            <Grid
                x:Name="FileListHost"
                Grid.Row="1"
                Margin="0,28,0,0">
                <Border
                    x:Name="FileListCard"
                    Padding="0"
                    HorizontalAlignment="Stretch"
                    Background="#F8FAFC"
                    BorderBrush="#EEF2F7"
                    BorderThickness="1"
                    CornerRadius="12"
                    Visibility="Collapsed"
                    SnapsToDevicePixels="True"
                    UseLayoutRounding="True">
                    <Grid
                        x:Name="FileListBody"
                        SizeChanged="FileListBody_SizeChanged">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 顶部工具栏（色块分区，不随列表滚动） -->
                        <Border
                            Grid.Row="0"
                            Height="56"
                            Padding="16,0"
                            Background="#F1F5F9">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    x:Name="FileListCountText"
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Foreground="#0F172A"
                                    Text="{x:Static res:Strings.Home_FileCount}" />

                                <ui:Button
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource ClearFileListButtonStyle}"
                                    Content="{x:Static res:Strings.Home_ClearList}"
                                    Icon="{ui:SymbolIcon Symbol=Delete24, FontSize=14}"
                                    Click="ClearFileListButton_Click" />
                            </Grid>
                        </Border>

                        <ScrollViewer
                            x:Name="FileListScrollViewer"
                            Grid.Row="1"
                            Padding="12,12,12,4"
                            FocusVisualStyle="{x:Null}"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                            <ItemsControl
                                x:Name="FileListItems"
                                Focusable="False"
                                FocusVisualStyle="{x:Null}"
                                ItemTemplate="{StaticResource FileListItemTemplate}" />
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- 底部固定：清理策略操作栏 / 当前策略 + 提示栏 -->
        <StackPanel
            Grid.Row="2"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Bottom">
            <!-- 已选文件态：清理策略操作栏（固定底部） -->
            <Border
                x:Name="StrategyActionBar"
                Height="92"
                Margin="0,18,0,0"
                Padding="16,0"
                HorizontalAlignment="Stretch"
                Background="#F8FAFC"
                BorderBrush="#EEF2F7"
                BorderThickness="1"
                CornerRadius="12"
                Visibility="Collapsed"
                SnapsToDevicePixels="True"
                UseLayoutRounding="True">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Margin="0,0,16,0"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="#0F172A"
                        Text="{x:Static res:Strings.Home_StrategyLabel}" />

                    <ui:DropDownButton
                        x:Name="StrategySelectButton"
                        Grid.Column="1"
                        MinWidth="160"
                        Height="40"
                        Margin="0,0,16,0"
                        Padding="14,0"
                        VerticalAlignment="Center"
                        Appearance="Secondary"
                        Background="#FFFFFF"
                        BorderBrush="#EEF2F7"
                        BorderThickness="1"
                        CornerRadius="8"
                        FontSize="14"
                        Foreground="#0F172A"
                        Content="{x:Static res:Strings.Strategy_Export_Name}">
                        <ui:DropDownButton.Flyout>
                            <ContextMenu x:Name="ActiveStrategyMenu" />
                        </ui:DropDownButton.Flyout>
                    </ui:DropDownButton>

                    <TextBlock
                        x:Name="StrategyHintText"
                        Grid.Column="2"
                        Margin="0"
                        VerticalAlignment="Center"
                        FontSize="14"
                        FontWeight="Normal"
                        Foreground="#64748B"
                        Text="{x:Static res:Strings.Strategy_Export_Description}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />

                    <ui:Button
                        x:Name="ClearMetadataButton"
                        Grid.Column="3"
                        MinWidth="140"
                        Height="46"
                        Margin="20,0,0,0"
                        Padding="16,0"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right"
                        Appearance="Primary"
                        Background="#2563EB"
                        BorderBrush="#2563EB"
                        BorderThickness="0"
                        CornerRadius="8"
                        FontSize="16"
                        Foreground="White"
                        Content="{x:Static res:Strings.Home_ScrubButton}"
                        Click="ClearMetadataButton_Click">
                        <ui:Button.Icon>
                            <ui:ImageIcon
                                Width="20"
                                Height="20"
                                Source="pack://application:,,,/PlainBytes.MetadataScrubber;component/Assets/Images/broom-white.png" />
                        </ui:Button.Icon>
                    </ui:Button>
                </Grid>
            </Border>

            <!-- 策略卡片：浅底弱边框 -->
            <Border
                x:Name="StrategyCard"
                Margin="0,28,0,0"
                Padding="24"
                HorizontalAlignment="Stretch"
                Background="#F8FAFC"
                BorderBrush="#EEF2F7"
                BorderThickness="1"
                CornerRadius="12"
                SnapsToDevicePixels="True"
                UseLayoutRounding="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        Grid.ColumnSpan="3"
                        Height="24"
                        Margin="0,0,0,12"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="#0F172A"
                        Text="{x:Static res:Strings.Home_CurrentStrategy}" />

                    <Image
                        Grid.Row="1"
                        Grid.Column="0"
                        Width="48"
                        Height="48"
                        Margin="0,0,12,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        RenderOptions.BitmapScalingMode="HighQuality"
                        SnapsToDevicePixels="True"
                        Source="pack://application:,,,/PlainBytes.MetadataScrubber;component/Assets/Images/shield.png" />

                    <StackPanel
                        Grid.Row="1"
                        Grid.Column="1"
                        VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock
                                x:Name="IdleStrategyNameText"
                                VerticalAlignment="Center"
                                FontSize="18"
                                FontWeight="SemiBold"
                                Foreground="#0F172A"
                                Text="{x:Static res:Strings.Strategy_Export_Name}" />
                            <Border
                                x:Name="IdleDefaultStrategyBadge"
                                Height="24"
                                Margin="10,0,0,0"
                                Padding="8,0"
                                VerticalAlignment="Center"
                                Background="#F1F5F9"
                                BorderThickness="0"
                                CornerRadius="5"
                                SnapsToDevicePixels="True">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="#64748B"
                                    Text="{x:Static res:Strings.Badge_Default}" />
                            </Border>
                        </StackPanel>
                        <TextBlock
                            x:Name="IdleStrategyHintText"
                            Margin="0,5,0,0"
                            FontSize="14"
                            FontWeight="Normal"
                            Foreground="#64748B"
                            Text="{x:Static res:Strings.Strategy_Export_Description}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                    </StackPanel>

                    <ui:DropDownButton
                        x:Name="IdleChangeStrategyButton"
                        Grid.Row="1"
                        Grid.Column="2"
                        MinWidth="140"
                        Height="44"
                        Margin="16,0,0,0"
                        Padding="20,0"
                        VerticalAlignment="Center"
                        Appearance="Secondary"
                        Background="#FFFFFF"
                        BorderBrush="#EEF2F7"
                        BorderThickness="1"
                        CornerRadius="8"
                        FontSize="14"
                        Foreground="#0F172A"
                        Content="{x:Static res:Strings.Home_ChangeStrategy}">
                        <ui:DropDownButton.Flyout>
                            <ContextMenu x:Name="IdleStrategyMenu" />
                        </ui:DropDownButton.Flyout>
                    </ui:DropDownButton>
                </Grid>
            </Border>

            <!-- 底部提示：石板浅底，无蓝洗 -->
            <Border
                x:Name="TipBar"
                Height="58"
                Margin="0,20,0,0"
                Padding="20,0"
                HorizontalAlignment="Stretch"
                Background="#F1F5F9"
                CornerRadius="10"
                SnapsToDevicePixels="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel
                        Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                        <ui:SymbolIcon
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            FontSize="16"
                            Foreground="#64748B"
                            Symbol="Info24" />
                        <TextBlock
                            x:Name="TipBarText"
                            VerticalAlignment="Center"
                            FontSize="14"
                            FontWeight="Normal"
                            Foreground="#64748B"
                            Text="{x:Static res:Strings.Home_TipBar}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                    </StackPanel>

                    <ui:HyperlinkButton
                        Grid.Column="1"
                        Margin="16,0,0,0"
                        Padding="0"
                        VerticalAlignment="Center"
                        Appearance="Transparent"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="#475569"
                        Content="{x:Static res:Strings.Home_LearnMore}"
                        Click="LearnMoreHyperlink_Click" />
                </Grid>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
