<UserControl
    x:Class="PlainBytes.MetadataScrubber.StrategyManagementView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:res="clr-namespace:PlainBytes.MetadataScrubber.Resources"
    d:DesignHeight="560"
    d:DesignWidth="800"
    FontFamily="{DynamicResource PB.Fonts.Main}"
    Foreground="{DynamicResource PB.Brushes.TextPrimary}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style
            x:Key="StrategyHeaderActionButtonStyle"
            BasedOn="{StaticResource {x:Type ui:Button}}"
            TargetType="ui:Button">
            <Setter Property="Height" Value="40" />
            <Setter Property="MinWidth" Value="110" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Appearance" Value="Secondary" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#EEF2F7" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F8FAFC" />
                    <Setter Property="BorderBrush" Value="#E2E8F0" />
                    <Setter Property="Foreground" Value="#0F172A" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style
            x:Key="StrategyHeaderPrimaryButtonStyle"
            BasedOn="{StaticResource StrategyHeaderActionButtonStyle}"
            TargetType="ui:Button">
            <Setter Property="Appearance" Value="Primary" />
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="BorderBrush" Value="#2563EB" />
            <Setter Property="Foreground" Value="White" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1A5AD9" />
                    <Setter Property="BorderBrush" Value="#1A5AD9" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style
            x:Key="StrategyHeaderDangerButtonStyle"
            BasedOn="{StaticResource StrategyHeaderActionButtonStyle}"
            TargetType="ui:Button">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#FED4D5" />
            <Setter Property="Foreground" Value="#F67069" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FEF2F2" />
                    <Setter Property="BorderBrush" Value="#F67069" />
                    <Setter Property="Foreground" Value="#F67069" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style
            x:Key="StrategyMoreButtonStyle"
            BasedOn="{StaticResource {x:Type ui:Button}}"
            TargetType="ui:Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Appearance" Value="Transparent" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F5F9" />
                    <Setter Property="Foreground" Value="#334155" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StrategyListItemStyle" TargetType="Border">
            <Setter Property="MinHeight" Value="78" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Padding" Value="0,12" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#EEF2F7" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F5F9" />
                    <Setter Property="BorderBrush" Value="#E2E8F0" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="StrategyListItemTemplate">
            <Border
                Cursor="Hand"
                MouseLeftButtonUp="StrategyListItem_Click">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource StrategyListItemStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="Background" Value="#F1F5F9" />
                                <Setter Property="BorderBrush" Value="#E2E8F0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel LastChildFill="True">
                    <!-- 选中条：阅读方向起点侧 3px -->
                    <Border
                        Width="3"
                        Height="20"
                        Margin="4,0,0,0"
                        DockPanel.Dock="Left"
                        VerticalAlignment="Center"
                        Background="#2563EB"
                        CornerRadius="2"
                        SnapsToDevicePixels="True">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>

                    <Grid Margin="16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Image
                            Grid.Column="0"
                            Width="40"
                            Height="40"
                            Margin="0,0,14,0"
                            VerticalAlignment="Center"
                            RenderOptions.BitmapScalingMode="HighQuality"
                            Source="{Binding IconPath}" />

                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="#0F172A"
                                Text="{Binding Name}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Margin="0,4,0,0"
                                FontSize="12"
                                FontWeight="Normal"
                                Foreground="#94A3B8"
                                Text="{Binding Description}"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <ui:Button
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Style="{StaticResource StrategyMoreButtonStyle}"
                            Click="StrategyMoreButton_Click">
                            <ui:Button.Icon>
                                <ui:SymbolIcon FontSize="16">
                                    <ui:SymbolIcon.Style>
                                        <Style TargetType="ui:SymbolIcon">
                                            <Setter Property="Symbol" Value="MoreVertical24" />
                                            <Setter Property="Foreground" Value="#94A3B8" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                                    <Setter Property="Symbol" Value="Star24" />
                                                    <Setter Property="Filled" Value="True" />
                                                    <Setter Property="Foreground" Value="#2563EB" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:SymbolIcon.Style>
                                </ui:SymbolIcon>
                            </ui:Button.Icon>
                        </ui:Button>
                    </Grid>
                </DockPanel>
            </Border>
        </DataTemplate>

        <Style x:Key="StrategyFieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

        <Style x:Key="StrategyFieldTextBoxStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="StrategyFieldBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#EEF2F7" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style x:Key="CleanupScopeItemStyle" TargetType="Border">
            <Setter Property="MinHeight" Value="70" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#EEF2F7" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <DataTemplate x:Key="CleanupScopeItemTemplate">
            <Border Style="{StaticResource CleanupScopeItemStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Image
                        Grid.Column="0"
                        Width="40"
                        Height="40"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        RenderOptions.BitmapScalingMode="HighQuality"
                        Source="{Binding IconPath}" />

                    <StackPanel
                        Grid.Column="1"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center">
                        <TextBlock
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="#0F172A"
                            Text="{Binding Name}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Margin="0,4,0,0"
                            FontSize="12"
                            FontWeight="Normal"
                            Foreground="#94A3B8"
                            Text="{Binding Description}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <ui:ToggleSwitch
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                        IsEnabled="{Binding IsEditable}" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid UseLayoutRounding="True" SnapsToDevicePixels="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页面标题 -->
        <Grid
            Grid.Row="0"
            Margin="0,0,0,28"
            HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Column="0"
                HorizontalAlignment="Stretch"
                Orientation="Horizontal">
                <Image
                    Width="40"
                    Height="40"
                    Margin="0,0,16,0"
                    VerticalAlignment="Center"
                    RenderOptions.BitmapScalingMode="HighQuality"
                    SnapsToDevicePixels="True"
                    Source="pack://application:,,,/PlainBytes.Core;component/Assets/Images/shield.png" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock
                        FontSize="30"
                        FontWeight="SemiBold"
                        LineHeight="40"
                        LineStackingStrategy="BlockLineHeight"
                        Foreground="#0F172A"
                        Text="{x:Static res:Strings.StrategyPage_Title}" />
                    <TextBlock
                        Margin="0,6,0,0"
                        FontSize="15"
                        FontWeight="Normal"
                        LineHeight="24"
                        LineStackingStrategy="BlockLineHeight"
                        Foreground="{DynamicResource PB.Brushes.TextSecondary}"
                        Text="{x:Static res:Strings.StrategyPage_Subtitle}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>

            <StackPanel
                Grid.Column="1"
                Margin="24,0,0,0"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <ui:Button
                    Style="{StaticResource StrategyHeaderPrimaryButtonStyle}"
                    Content="{x:Static res:Strings.StrategyPage_New}"
                    Icon="{ui:SymbolIcon Symbol=Add24, FontSize=16}"
                    Click="NewStrategyButton_Click" />
                <ui:Button
                    Style="{StaticResource StrategyHeaderActionButtonStyle}"
                    Content="{x:Static res:Strings.StrategyPage_Import}"
                    Icon="{ui:SymbolIcon Symbol=ArrowUpload24, FontSize=16}"
                    Visibility="Collapsed"
                    Click="ImportStrategyButton_Click" />
                <ui:Button
                    Style="{StaticResource StrategyHeaderActionButtonStyle}"
                    Content="{x:Static res:Strings.StrategyPage_Export}"
                    Icon="{ui:SymbolIcon Symbol=ArrowDownload24, FontSize=16}"
                    Visibility="Collapsed"
                    Click="ExportStrategyButton_Click" />
            </StackPanel>
        </Grid>

        <!-- 主体：色块分区（侧栏浅底 + 详情白底），无竖分割线；圆角 Clip -->
        <Border
            Grid.Row="1"
            Background="#F8FAFC"
            BorderBrush="#EEF2F7"
            BorderThickness="1"
            CornerRadius="12"
            Padding="0"
            SnapsToDevicePixels="True"
            UseLayoutRounding="True">
            <Grid
                x:Name="StrategyBody"
                SizeChanged="StrategyBody_SizeChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360" />
                    <ColumnDefinition Width="*" MinWidth="320" />
                </Grid.ColumnDefinitions>

                <!-- 左侧：我的策略 -->
                <Border
                    Grid.Column="0"
                    Background="#F8FAFC"
                    Padding="20,20,20,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Margin="0,0,0,14"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Foreground="#0F172A"
                            Text="{x:Static res:Strings.StrategyPage_MyStrategies}" />

                        <ScrollViewer
                            Grid.Row="1"
                            Margin="0,0,0,10"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto"
                            FocusVisualStyle="{x:Null}">
                            <ItemsControl
                                x:Name="StrategyListItems"
                                ItemTemplate="{StaticResource StrategyListItemTemplate}" />
                        </ScrollViewer>

                        <Grid
                            Grid.Row="2"
                            Margin="0,0,0,20"
                            VerticalAlignment="Bottom">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon
                                Grid.Column="0"
                                Margin="0,5,8,0"
                                VerticalAlignment="Top"
                                FontSize="14"
                                Foreground="#94A3B8"
                                Symbol="Info24" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Top"
                                FontSize="12"
                                FontWeight="Normal"
                                Foreground="#94A3B8"
                                Text="{x:Static res:Strings.StrategyPage_DefaultHint}"
                                TextWrapping="Wrap" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- 右侧：策略详情 -->
                <Border
                    Grid.Column="1"
                    Background="#FFFFFF"
                    CornerRadius="0,12,12,0"
                    Padding="20,20,20,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="0" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel
                            Grid.Row="0"
                            Margin="0,0,0,20"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                            <Image
                                x:Name="StrategyDetailIcon"
                                Width="28"
                                Height="28"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"
                                RenderOptions.BitmapScalingMode="HighQuality"
                                SnapsToDevicePixels="True" />
                            <TextBlock
                                x:Name="StrategyDetailTitleText"
                                VerticalAlignment="Center"
                                FontSize="18"
                                FontWeight="SemiBold"
                                Foreground="#0F172A"
                                Text="" />
                        </StackPanel>

                        <ScrollViewer
                            Grid.Row="1"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto"
                            FocusVisualStyle="{x:Null}">
                            <StackPanel HorizontalAlignment="Stretch">
                                <StackPanel Margin="0,0,0,20" HorizontalAlignment="Stretch">
                                    <TextBlock
                                        Style="{StaticResource StrategyFieldLabelStyle}"
                                        Text="{x:Static res:Strings.StrategyPage_Name}" />
                                    <Border
                                        x:Name="StrategyNameFieldBorder"
                                        Style="{StaticResource StrategyFieldBorderStyle}"
                                        Height="40">
                                        <TextBox
                                            x:Name="StrategyNameTextBox"
                                            Style="{StaticResource StrategyFieldTextBoxStyle}"
                                            IsReadOnly="True"
                                            IsTabStop="False"
                                            Cursor="Arrow" />
                                    </Border>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,24" HorizontalAlignment="Stretch">
                                    <TextBlock
                                        Style="{StaticResource StrategyFieldLabelStyle}"
                                        Text="{x:Static res:Strings.StrategyPage_Description}" />
                                    <Border
                                        x:Name="StrategyDescriptionFieldBorder"
                                        Style="{StaticResource StrategyFieldBorderStyle}"
                                        Height="84">
                                        <TextBox
                                            x:Name="StrategyDescriptionTextBox"
                                            Style="{StaticResource StrategyFieldTextBoxStyle}"
                                            IsReadOnly="True"
                                            IsTabStop="False"
                                            Cursor="Arrow"
                                            AcceptsReturn="True"
                                            TextWrapping="Wrap"
                                            VerticalContentAlignment="Top"
                                            VerticalScrollBarVisibility="Auto" />
                                    </Border>
                                </StackPanel>

                                <StackPanel HorizontalAlignment="Stretch">
                                    <TextBlock
                                        Margin="0,0,0,12"
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Foreground="#0F172A"
                                        Text="{x:Static res:Strings.StrategyPage_ScopeHeading}" />
                                    <ItemsControl
                                        x:Name="CleanupScopeItems"
                                        ItemTemplate="{StaticResource CleanupScopeItemTemplate}" />

                                    <Border
                                        Margin="0,5,0,0"
                                        Padding="12,10"
                                        Background="#F1F5F9"
                                        BorderThickness="0"
                                        CornerRadius="8"
                                        SnapsToDevicePixels="True">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ui:SymbolIcon
                                                Grid.Column="0"
                                                Margin="0,2,8,0"
                                                VerticalAlignment="Top"
                                                FontSize="14"
                                                Foreground="#64748B"
                                                Symbol="Info24" />
                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                FontWeight="Normal"
                                                Foreground="#64748B"
                                                Text="{x:Static res:Strings.StrategyPage_ScopeHint}"
                                                TextWrapping="Wrap" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <Grid
                            Grid.Row="2"
                            Margin="0,20,0,20"
                            HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:Button
                                Grid.Column="0"
                                Style="{StaticResource StrategyHeaderActionButtonStyle}"
                                Margin="0"
                                Content="{x:Static res:Strings.StrategyPage_SetDefault}"
                                Click="SetDefaultStrategyButton_Click" />

                            <StackPanel
                                Grid.Column="2"
                                Orientation="Horizontal">
                                <ui:Button
                                    x:Name="DeleteStrategyButton"
                                    Style="{StaticResource StrategyHeaderDangerButtonStyle}"
                                    Content="{x:Static res:Strings.StrategyPage_Delete}"
                                    Icon="{ui:SymbolIcon Symbol=Delete24, FontSize=16}"
                                    Click="DeleteStrategyButton_Click" />
                                <ui:Button
                                    x:Name="CancelStrategyButton"
                                    Style="{StaticResource StrategyHeaderActionButtonStyle}"
                                    Content="{x:Static res:Strings.Common_Cancel}"
                                    Click="CancelStrategyButton_Click" />
                                <ui:Button
                                    x:Name="SaveStrategyButton"
                                    Style="{StaticResource StrategyHeaderPrimaryButtonStyle}"
                                    Content="{x:Static res:Strings.StrategyPage_Save}"
                                    Click="SaveStrategyButton_Click" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
